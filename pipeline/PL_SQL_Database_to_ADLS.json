					"source": {
						"type": "AzureSqlSource",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false
				},
				"outputs": [
					{
						"referenceName": "DS_csv_destination",
						"type": "DatasetReference"
					}
				]
			}
		],
		"parameters": {
			"PL_tableName": {
				"type": "string",
				"defaultValue": "Employees"
			}
		},
		"folder": {
			"name": "Demo"
		},
		"annotations": [],
		"lastPublishTime": "2026-11-07T08:31:45Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
