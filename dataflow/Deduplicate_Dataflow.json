{
	"name": "Deduplicate_Dataflow",
	"properties": {
		"folder": {
			"name": "Demo"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_dataflow_employee_source",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_dataflow_join_destination",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "flowlet1",
					"flowlet": {
						"referenceName": "deduplicate_flowlet",
						"type": "DataFlowReference"
					}
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          emp_id as string,",
				"          emp_name as string,",
				"          dept_id as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"derivedColumn1 compose(mapColumn(",
				"          emp_id,",
				"          emp_name,",
				"          dept_id,",
				"          dept_name",
				"     ),",
				"     composition: 'deduplicate_flowlet') ~> flowlet1@(temporary)",
				"source1 derive(emp_id = emp_id,",
				"          emp_name = emp_name,",
				"          dept_id = dept_id,",
				"          dept_name = dept_id) ~> derivedColumn1",
				"flowlet1@temporary sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}