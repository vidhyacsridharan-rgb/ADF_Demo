{
	"name": "deduplicate_flowlet",
	"properties": {
		"folder": {
			"name": "Demo"
		},
		"type": "Flowlet",
		"typeProperties": {
			"sources": [],
			"sinks": [],
			"transformations": [
				{
					"name": "aggregate"
				},
				{
					"name": "input1"
				},
				{
					"name": "output1"
				}
			],
			"scriptLines": [
				"input(output(",
				"          emp_id as string,",
				"          emp_name as string,",
				"          dept_id as string,",
				"          dept_name as string",
				"     ),",
				"     order: 0,",
				"     allowSchemaDrift: true) ~> input1",
				"input1 aggregate(groupBy(emp_id,",
				"          emp_name,",
				"          dept_id,",
				"          dept_name),",
				"     count = count()) ~> aggregate",
				"aggregate output(mapColumn(",
				"          emp_id,",
				"          emp_name,",
				"          dept_id,",
				"          dept_name",
				"     )) ~> output1"
			]
		}
	}
}